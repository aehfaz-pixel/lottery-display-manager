{
  "name": "lottery-electron",
  "version": "1.0.1",
  "description": "Lottery Manager — Electron App",
  "author": "Lottery Manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set NODE_ENV=development && electron .",
    "rebuild-hid": "electron-rebuild -f -w uiohook-napi",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.lottery.manager",
    "productName": "Lottery Manager",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "aehfaz-pixel",
      "repo": "lottery-display-manager",
      "private": true
    }
  }
}
